# vhs tape — record docs/sigil-risky-config-demo.gif
# Run from repo root:  vhs scripts/demo/risky-config-demo.tape
Output docs/sigil-risky-config-demo.gif

Require bash
Set Shell bash
Set Theme "Dracula"
Set FontSize 16
Set Width 1120
Set Height 900
Set Padding 26
Set TypingSpeed 55ms

Sleep 600ms
Type "bash scripts/demo/risky-config-demo.sh"
Sleep 500ms
Enter
Sleep 9s
Sleep 1500ms
